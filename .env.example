# TKTKNUEVA — copy to .env (never commit .env)

APP_NAME=TKTKNUEVA
DEV_MODE=true

# Dashboard operator (used only when users.json is empty in DEV_MODE)
TKTK_ADMIN_USER=admin
TKTK_ADMIN_PASSWORD=changeme

# Runtime paths — on a VPS point these to /var/lib/tktknueva/...
TKTK_DATA_PATH=
TKTK_LOG_PATH=
TKTK_PROFILES_PATH=
TKTK_UPLOADS_PATH=

# Optional TikTok official API (Content Posting / Login Kit)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_ENABLED=false

# Worker
PYTHON_PATH=python3
CHROME_PATH=
CHROMEDRIVER_PATH=
SCHEDULER_ENABLED=true
SELENIUM_ENABLED=true
